# Variables de entorno de Prompter. Configurar en Vercel → Project → Settings → Environment Variables.
# NUNCA subir valores reales a GitHub. Las claves de servicio y secretos solo existen en el servidor.

# Supabase (Project Settings → API)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Demostración sin cobro: solo funciona fuera de producción (VERCEL_ENV distinto de "production").
BILLING_DEMO=false

# PayPal (dejar vacío hasta activar los pagos: la cuenta muestra «próximamente»)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID=
PAYPAL_WEBHOOK_ID=
# Cobros reales: requiere PAYPAL_MODE=live y aprobación explícita.
PAYPAL_LIVE_ENABLED=false
